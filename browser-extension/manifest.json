{
  "manifest_version": 3,
  "name": "施工图管理桥接",
  "version": "0.5.0",
  "description": "只读连接施工图配置与设计页，供 Agent 查询配置名称、状态及线样式。",
  "permissions": [
    "scripting",
    "storage",
    "alarms",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://www.kujiale.com/*",
    "https://beta.kujiale.com/*",
    "https://yun.kujiale.com/*",
    "https://yun-beta.kujiale.com/*"
  ],
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "minimum_chrome_version": "120",
  "key": ""
}

